          <mxGeometry x="480" y="40" width="150" height="22" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="4 授权 / 审计（AuthZ）" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="660" y="40" width="170" height="22" as="geometry" />
        </mxCell>

        <mxCell id="lane1" value="操作员 / 看板" style="swimlane;horizontal=0;startSize=110;fillColor=#f5f5f5;strokeColor=#999999;html=1;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="880" height="150" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="OIDC / SAML 登录&lt;br&gt;&lt;small&gt;→ JWT&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="lane1">
          <mxGeometry x="120" y="40" width="150" height="75" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="HTTPS / WSS&lt;br&gt;&lt;small&gt;JWT Bearer&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="lane1">
          <mxGeometry x="300" y="40" width="150" height="75" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="GET /api/*&lt;br&gt;&lt;small&gt;WS /ws/live&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="lane1">
          <mxGeometry x="480" y="40" width="150" height="75" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="RBAC&lt;br&gt;&lt;small&gt;viewer / operator + audit&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="lane1">
          <mxGeometry x="660" y="40" width="170" height="75" as="geometry" />
        </mxCell>

        <mxCell id="lane2" value="WMS" style="swimlane;horizontal=0;startSize=110;fillColor=#f5f5f5;strokeColor=#999999;html=1;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="880" height="150" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="mTLS 证书&lt;br&gt;&lt;small&gt;或 OAuth2 client credentials&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="lane2">
          <mxGeometry x="120" y="40" width="150" height="75" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="TLS 8883&lt;br&gt;&lt;small&gt;双向证书&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="lane2">
          <mxGeometry x="300" y="40" width="150" height="75" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="publish wms/task&lt;br&gt;&lt;small&gt;subscribe wms/task/ack&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="lane2">
          <mxGeometry x="480" y="40" width="150" height="75" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="ACL&lt;br&gt;&lt;small&gt;只允许 wms/task + ack&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="lane2">
          <mxGeometry x="660" y="40" width="170" height="75" as="geometry" />
