  <diagram id="auth-flow" name="认证与鉴权流程">
    <mxGraphModel dx="960" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="780" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="认证与鉴权：不同阶段 / 功能的认证方式" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="880" height="30" as="geometry" />
        </mxCell>

