          <mxGeometry x="120" y="40" width="150" height="22" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="2 通道（Transport）" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="150" height="22" as="geometry" />
        </mxCell>
