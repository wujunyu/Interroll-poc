# 复制为 .env 后按需改；.env 不进 git
COMPOSE_PROJECT_NAME=interroll-poc

# ---- 端口（避开宿主已占的 1883/5432/8000/5173）----
MQTT_PORT=1884
DB_PORT=5433
API_PORT=8001
WEB_PORT=5174

# ---- 数据库 ----
DB_NAME=poc
DB_USER=poc
DB_PASSWORD=change-me-in-.env

# ---- 采集 ----
SAMPLE_HZ=10
ZONES=6
DRIVES_PER_ZONE=6

# ---- 版本（rollback 用）----
APP_VERSION=v0.1.0
