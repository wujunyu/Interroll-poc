# 复制为 .env 后按需改；.env 不进 git
COMPOSE_PROJECT_NAME=interroll-poc

# ---- 端口（避开宿主已占的 1883/5432/8000/5173）----
MQTT_PORT=1884
DB_PORT=5433
API_PORT=8001
WEB_PORT=5174

# ---- 数据库 ----
DB_NAME=poc
DB_USER=poc
DB_PASSWORD=change-me-in-.env

# ---- 采集 ----
SAMPLE_HZ=10
ZONES=6
DRIVES_PER_ZONE=6

# ---- 版本（rollback 用）----
APP_VERSION=0.3.1

# ---- 本机开发（复用宿主已有服务，不另起容器）----
# 宿主 mosquitto:1883（需账号）/ timescaledb:5437（5432 被 immichPG 占用）
# MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_USERNAME=poc
# MQTT_PASSWORD=poc_dev_pw
# DB_DSN=postgresql://poc:poc_dev_pw@127.0.0.1:5437/interroll_poc
